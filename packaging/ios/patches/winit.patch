+unsafe impl NSObjectProtocol for WinitApplicationDelegate {}
+
+/// Queues the file at `url` for the window to open; false for a URL that isn't a file.
+fn open_file_url(application: &UIApplication, url: &NSURL) -> bool {
+    if !unsafe { url.isFileURL() } {
+        return false;
+    }
+    // In place (the Files app) or a copy in Documents/Inbox (another app's share sheet): either
+    // way the app may read it now and save to it later.
+    let _ = unsafe { url.startAccessingSecurityScopedResource() };
+    let Some(path) = (unsafe { url.path() }) else { return false };
+    super::push_opened_file(std::path::PathBuf::from(path.to_string()));
+    // Wake the window, which hands the file over on its next draw.
+    #[allow(deprecated)]
+    let windows = application.windows();
+    for window in windows.iter() {
+        if let Some(view) = window.rootViewController().and_then(|vc| vc.view()) {
+            view.setNeedsDisplay();
+        }
+    }
+    true
+}
diff --git a/src/platform_impl/ios/input.rs b/src/platform_impl/ios/input.rs
new file mode 100644
index 0000000..057a318
--- /dev/null
+++ b/src/platform_impl/ios/input.rs
@@ -0,0 +1,290 @@
+//! Hardware keyboard keys on iOS: `UIKey`'s USB HID usage as a winit [`KeyCode`], the named key
+//! it produces, and its modifier flags as [`ModifiersState`].
+
+use objc2_ui_kit::UIKeyModifierFlags;
+
+use crate::keyboard::{KeyCode, KeyLocation, ModifiersState, NamedKey};
+
+/// The physical key of a HID usage (USB HID Usage Tables, keyboard page 0x07).
+pub(crate) fn key_code(usage: isize) -> Option<KeyCode> {
+    use KeyCode::*;
+    const LETTERS: [KeyCode; 26] = [
+        KeyA, KeyB, KeyC, KeyD, KeyE, KeyF, KeyG, KeyH, KeyI, KeyJ, KeyK, KeyL, KeyM, KeyN, KeyO,
+        KeyP, KeyQ, KeyR, KeyS, KeyT, KeyU, KeyV, KeyW, KeyX, KeyY, KeyZ,
+    ];
+    const DIGITS: [KeyCode; 10] =
+        [Digit1, Digit2, Digit3, Digit4, Digit5, Digit6, Digit7, Digit8, Digit9, Digit0];
+    const F1_12: [KeyCode; 12] = [F1, F2, F3, F4, F5, F6, F7, F8, F9, F10, F11, F12];
+    const F13_24: [KeyCode; 12] = [F13, F14, F15, F16, F17, F18, F19, F20, F21, F22, F23, F24];
+    const NUMPAD: [KeyCode; 10] = [
+        Numpad1, Numpad2, Numpad3, Numpad4, Numpad5, Numpad6, Numpad7, Numpad8, Numpad9, Numpad0,
+    ];
+    let index = |start: isize| (usage - start) as usize;
+    Some(match usage {
+        0x04..=0x1d => LETTERS[index(0x04)],
+        0x1e..=0x27 => DIGITS[index(0x1e)],
+        0x28 => Enter,
+        0x29 => Escape,
+        0x2a => Backspace,
+        0x2b => Tab,
+        0x2c => Space,
+        0x2d => Minus,
+        0x2e => Equal,
+        0x2f => BracketLeft,
+        0x30 => BracketRight,
+        0x31 | 0x32 => Backslash,
+        0x33 => Semicolon,
+        0x34 => Quote,
+        0x35 => Backquote,
+        0x36 => Comma,
+        0x37 => Period,
+        0x38 => Slash,
+        0x39 => CapsLock,
+        0x3a..=0x45 => F1_12[index(0x3a)],
+        0x46 => PrintScreen,
+        0x47 => ScrollLock,
+        0x48 => Pause,
+        0x49 => Insert,
+        0x4a => Home,
+        0x4b => PageUp,
+        0x4c => Delete,
+        0x4d => End,
+        0x4e => PageDown,
+        0x4f => ArrowRight,
+        0x50 => ArrowLeft,
+        0x51 => ArrowDown,
+        0x52 => ArrowUp,
+        0x53 => NumLock,
+        0x54 => NumpadDivide,
+        0x55 => NumpadMultiply,
+        0x56 => NumpadSubtract,
+        0x57 => NumpadAdd,
+        0x58 => NumpadEnter,
+        0x59..=0x62 => NUMPAD[index(0x59)],
+        0x63 => NumpadDecimal,
+        0x64 => IntlBackslash,
+        0x65 => ContextMenu,
+        0x66 => Power,
+        0x67 => NumpadEqual,
+        0x68..=0x73 => F13_24[index(0x68)],
+        0x85 => NumpadComma,
+        0x87 => IntlRo,
+        0x89 => IntlYen,
+        0x90 => Lang1,
+        0x91 => Lang2,
+        0xe0 => ControlLeft,
+        0xe1 => ShiftLeft,
+        0xe2 => AltLeft,
+        0xe3 => SuperLeft,
+        0xe4 => ControlRight,
+        0xe5 => ShiftRight,
+        0xe6 => AltRight,
+        0xe7 => SuperRight,
+        _ => return None,
+    })
+}
+
+/// The key a physical key produces when it isn't a character: arrows, editing and function keys,
+/// and the modifiers. `None` for the character keys, whose character the layout decides.
+pub(crate) fn named_key(code: KeyCode) -> Option<NamedKey> {
+    use KeyCode as C;
+    use NamedKey as N;
+    Some(match code {
+        C::Enter | C::NumpadEnter => N::Enter,
+        C::Escape => N::Escape,
+        C::Backspace => N::Backspace,
+        C::Tab => N::Tab,
+        C::Space => N::Space,
+        C::CapsLock => N::CapsLock,
+        C::F1 => N::F1,
+        C::F2 => N::F2,
+        C::F3 => N::F3,
+        C::F4 => N::F4,
+        C::F5 => N::F5,
+        C::F6 => N::F6,
+        C::F7 => N::F7,
+        C::F8 => N::F8,
+        C::F9 => N::F9,
+        C::F10 => N::F10,
+        C::F11 => N::F11,
+        C::F12 => N::F12,
+        C::F13 => N::F13,
+        C::F14 => N::F14,
+        C::F15 => N::F15,
+        C::F16 => N::F16,
+        C::F17 => N::F17,
+        C::F18 => N::F18,
+        C::F19 => N::F19,
+        C::F20 => N::F20,
+        C::F21 => N::F21,
+        C::F22 => N::F22,
+        C::F23 => N::F23,
+        C::F24 => N::F24,
+        C::PrintScreen => N::PrintScreen,
+        C::ScrollLock => N::ScrollLock,
+        C::Pause => N::Pause,
+        C::Insert => N::Insert,
+        C::Home => N::Home,
+        C::PageUp => N::PageUp,
+        C::Delete => N::Delete,
+        C::End => N::End,
+        C::PageDown => N::PageDown,
+        C::ArrowRight => N::ArrowRight,
+        C::ArrowLeft => N::ArrowLeft,
+        C::ArrowDown => N::ArrowDown,
+        C::ArrowUp => N::ArrowUp,
+        C::NumLock => N::NumLock,
+        C::ContextMenu => N::ContextMenu,
+        C::Power => N::Power,
+        C::ControlLeft | C::ControlRight => N::Control,
+        C::ShiftLeft | C::ShiftRight => N::Shift,
+        C::AltLeft | C::AltRight => N::Alt,
+        C::SuperLeft | C::SuperRight => N::Super,
+        _ => return None,
+    })
+}
+
+/// Where the key is: left or right modifier, the numeric keypad, or anywhere else.
+pub(crate) fn location(code: KeyCode) -> KeyLocation {
+    use KeyCode as C;
+    match code {
+        C::ControlLeft | C::ShiftLeft | C::AltLeft | C::SuperLeft => KeyLocation::Left,
+        C::ControlRight | C::ShiftRight | C::AltRight | C::SuperRight => KeyLocation::Right,
+        C::NumLock
+        | C::NumpadDivide
+        | C::NumpadMultiply
+        | C::NumpadSubtract
+        | C::NumpadAdd
+        | C::NumpadEnter
+        | C::Numpad0
+        | C::Numpad1
+        | C::Numpad2
+        | C::Numpad3
+        | C::Numpad4
+        | C::Numpad5
+        | C::Numpad6
+        | C::Numpad7
+        | C::Numpad8
+        | C::Numpad9
+        | C::NumpadDecimal
+        | C::NumpadEqual
+        | C::NumpadComma => KeyLocation::Numpad,
+        _ => KeyLocation::Standard,
+    }
+}
+
+/// One bit per modifier key held, left and right apart.
+pub(crate) fn modifier_bit(code: KeyCode) -> Option<u8> {
+    use KeyCode as C;
+    Some(match code {
+        C::ShiftLeft => 1 << 0,
+        C::ShiftRight => 1 << 1,
+        C::ControlLeft => 1 << 2,
+        C::ControlRight => 1 << 3,
+        C::AltLeft => 1 << 4,
+        C::AltRight => 1 << 5,
+        C::SuperLeft => 1 << 6,
+        C::SuperRight => 1 << 7,
+        _ => return None,
+    })
+}
+
+/// The modifiers the held modifier keys make.
+pub(crate) fn held_state(held: u8) -> ModifiersState {
+    let mut state = ModifiersState::empty();
+    state.set(ModifiersState::SHIFT, held & 0b11 != 0);
+    state.set(ModifiersState::CONTROL, held & 0b1100 != 0);
+    state.set(ModifiersState::ALT, held & 0b11_0000 != 0);
+    state.set(ModifiersState::SUPER, held & 0b1100_0000 != 0);
+    state
+}
+
+/// The held modifier keys that `state` still has: a key whose release never arrived (Command-Tab
+/// to another app) is dropped once UIKit's flags say its modifier is up.
+pub(crate) fn held_within(held: u8, state: ModifiersState) -> u8 {
+    let mut kept = held;
+    if !state.shift_key() {
+        kept &= !0b11;
+    }
+    if !state.control_key() {
+        kept &= !0b1100;
+    }
+    if !state.alt_key() {
+        kept &= !0b11_0000;
+    }
+    if !state.super_key() {
+        kept &= !0b1100_0000;
+    }
+    kept
+}
+
+/// UIKit's modifier flags as winit's: Command is Super, as on macOS.
+pub(crate) fn flags_state(flags: UIKeyModifierFlags) -> ModifiersState {
+    let mut state = ModifiersState::empty();
+    state.set(ModifiersState::SHIFT, flags.contains(UIKeyModifierFlags::UIKeyModifierShift));
+    state.set(ModifiersState::CONTROL, flags.contains(UIKeyModifierFlags::UIKeyModifierControl));
+    state.set(ModifiersState::ALT, flags.contains(UIKeyModifierFlags::UIKeyModifierAlternate));
+    state.set(ModifiersState::SUPER, flags.contains(UIKeyModifierFlags::UIKeyModifierCommand));
+    state
+}
+
+/// The US-layout character of a character key, for a shortcut whose `UIKey` gave no characters.
+pub(crate) fn us_character(code: KeyCode) -> Option<char> {
+    use KeyCode as C;
+    let letters = "abcdefghijklmnopqrstuvwxyz";
+    let letter_codes = [
+        C::KeyA,
+        C::KeyB,
+        C::KeyC,
+        C::KeyD,
+        C::KeyE,
+        C::KeyF,
+        C::KeyG,
+        C::KeyH,
+        C::KeyI,
+        C::KeyJ,
+        C::KeyK,
+        C::KeyL,
+        C::KeyM,
+        C::KeyN,
+        C::KeyO,
+        C::KeyP,
+        C::KeyQ,
+        C::KeyR,
+        C::KeyS,
+        C::KeyT,
+        C::KeyU,
+        C::KeyV,
+        C::KeyW,
+        C::KeyX,
+        C::KeyY,
+        C::KeyZ,
+    ];
+    if let Some(i) = letter_codes.iter().position(|c| *c == code) {
+        return letters.chars().nth(i);
+    }
+    Some(match code {
+        C::Digit0 => '0',
+        C::Digit1 => '1',
+        C::Digit2 => '2',
+        C::Digit3 => '3',
+        C::Digit4 => '4',
+        C::Digit5 => '5',
+        C::Digit6 => '6',
+        C::Digit7 => '7',
+        C::Digit8 => '8',
+        C::Digit9 => '9',
+        C::Minus => '-',
+        C::Equal => '=',
+        C::BracketLeft => '[',
+        C::BracketRight => ']',
+        C::Backslash => '\\',
+        C::Semicolon => ';',
+        C::Quote => '\'',
+        C::Backquote => '`',
+        C::Comma => ',',
+        C::Period => '.',
+        C::Slash => '/',
+        _ => return None,
+    })
+}
