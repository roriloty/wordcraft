     }
 }
+
+/// Documents another app or the Files app asked this app to open (`application:openURL:options:`),
+/// waiting for the window to hand them over as dropped files.
+static OPENED_FILES: std::sync::Mutex<Vec<std::path::PathBuf>> = std::sync::Mutex::new(Vec::new());
+
+pub(crate) fn push_opened_file(path: std::path::PathBuf) {
+    if let Ok(mut files) = OPENED_FILES.lock() {
+        files.push(path);
+    }
+}
+
+pub(crate) fn take_opened_files() -> Vec<std::path::PathBuf> {
+    OPENED_FILES.lock().map(|mut files| std::mem::take(&mut *files)).unwrap_or_default()
+}
